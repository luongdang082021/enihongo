<!doctype html>
<html lang="{{ t.htmlLang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or t.tagline }}">
<link rel="canonical" href="{{ site.origin }}{{ page.url | url }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="theme-color" content="#EBEFF5" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0D1220" media="(prefers-color-scheme: dark)">
{% if alt %}<link rel="alternate" hreflang="vi" href="{{ site.origin }}{{ alt.vi | url }}">
<link rel="alternate" hreflang="en" href="{{ site.origin }}{{ alt.en | url }}">
<link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ alt.vi | url }}">
{% endif %}<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or t.tagline }}">
<meta property="og:url" content="{{ site.origin }}{{ page.url | url }}">
<meta property="og:image" content="{{ site.origin }}{{ '/icons/icon-512.png' | url }}">
<meta name="twitter:card" content="summary">
<link rel="icon" type="image/svg+xml" href="{{ '/icons/icon.svg' | url }}">
<link rel="apple-touch-icon" href="{{ '/icons/icon-192.png' | url }}">
<link rel="manifest" href="{{ '/manifest.webmanifest' | url }}">
{% if route == 'home' %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"{{ site.name }}","url":"{{ site.origin }}{{ page.url | url }}","inLanguage":"{{ lang }}","description":"{{ t.tagline }}"}</script>{% endif %}
{% if route == 'hiragana' %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Course","name":"{{ (courses[0] | l10n(lang)).name }}","description":"{{ t.hiragana.ld }}","inLanguage":"{{ lang }}","isAccessibleForFree":true,"provider":{"@type":"Organization","name":"{{ site.name }}","url":"{{ site.origin }}{{ '/' | url }}"}}</script>{% endif %}
<link rel="stylesheet" href="{{ '/css/main.css' | asset }}">
{% if quiz %}<link rel="stylesheet" href="{{ '/css/quiz.css' | asset }}">{% endif %}
</head>
<body>
<a class="skip" href="#main">{{ t.skip }}</a>
<header class="site-header">
  <div class="inner">
    <a class="brand" href="{{ 'home' | route(lang) | url }}"><span class="brand-cell" aria-hidden="true">あ</span><span>enihongo</span></a>
    <nav aria-label="{{ t.navLabel }}">
      <a href="{{ 'courses' | route(lang) | url }}"{% if page.url.startsWith('courses' | route(lang)) %} aria-current="page"{% endif %}>{{ t.navCourses }}</a>
      <a href="{{ 'practice' | route(lang) | url }}"{% if page.url.startsWith('practice' | route(lang)) %} aria-current="page"{% endif %}>{{ t.navPractice }}</a>
      <a href="{{ 'about' | route(lang) | url }}"{% if page.url == 'about' | route(lang) %} aria-current="page"{% endif %}>{{ t.navAbout }}</a>
      <a class="lang-switch" href="{{ (alt[t.switchLang] if alt else ('home' | route(t.switchLang))) | url }}" hreflang="{{ t.switchLang }}" lang="{{ t.switchLang }}" aria-label="{{ t.switchLabel }}" data-lang-switch="{{ t.switchLang }}">{{ t.switchTo }}</a>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="inner">
    <p>{{ t.footerTagline }}</p>
    <p><a href="{{ site.repo }}">{{ t.footerSource }}</a></p>
  </div>
</footer>
<script>if("serviceWorker"in navigator)addEventListener("load",function(){navigator.serviceWorker.register("{{ '/sw.js' | url }}").catch(function(){})})</script>
{% if site.cfBeaconToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfBeaconToken }}"}'></script>{% endif %}
{% if script %}<script type="module" src="{{ script | asset }}"></script>{% endif %}
</body>
</html>
