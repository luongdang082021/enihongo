{% for c0 in courses %}{% set c = c0 | l10n(lang) %}
      {% if c.status == 'open' %}
      <a class="course open" href="{{ c.id | route(lang) | url }}"><span class="badge go">{{ t.courses.open }}</span><h3>{{ c.name }}</h3><p>{{ c.blurb }}</p><p>{{ c.meta }}</p></a>
      {% else %}
      <div class="course soon"><span class="badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4V7z"/></svg>{{ t.courses.soon }}</span><h3>{{ c.name }}</h3><p>{{ c.blurb }}</p></div>
      {% endif %}
{% endfor %}
