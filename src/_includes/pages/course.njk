{% set hc = courses | byId(cid) | l10n(lang) %}
<div class="wrap">
  <nav class="crumbs" aria-label="{{ t.crumbs }}"><a href="{{ 'courses' | route(lang) | url }}">{{ t.courses.title }}</a> / {{ hc.name }}</nav>
  <header class="page-head">
    <h1>{{ hc.name }}</h1>
    <p class="lede">{{ hc.lede }}</p>
    {% if hc.prereq %}<p class="hint">{{ t.course.prereq }} <a href="{{ hc.prereq | route(lang) | url }}">{{ t.course.prereqLink }}</a></p>{% endif %}
    {% if t.course.notice and not hc.enLessons and lang == 'en' %}<p class="note-draft">{{ t.course.notice }}</p>{% endif %}
    <p class="progress-line" data-summary></p>
  </header>
  <ol class="lesson-list">
    {% for l0 in lessons[cid] %}{% set l = l0 | l10n(lang) %}
    {% if l.state == 'ready' %}
    <li data-lesson-id="{{ l.id }}"><a href="{{ (l | lessonUrl(cid, lang if hc.enLessons else 'vi')) | url }}"><span class="lnum">{{ l.n }}</span><span class="lt"><b>{{ l.title }}</b><span>{{ l.summary }}</span></span><span class="pill go" data-status>{{ t.course.learn }}</span></a></li>
    {% elif l.state == 'dojo' %}
    <li data-lesson-id="{{ l.id }}"><a href="{{ (('practice' | route(lang)) + '?khoa=' + cid) | url }}"><span class="lnum">{{ l.n }}</span><span class="lt"><b>{{ l.title }}</b><span>{{ l.summary }}</span></span><span class="pill go" data-status>{{ t.course.play }}</span></a></li>
    {% else %}
    <li class="soon"><div class="off"><span class="lnum">{{ l.n }}</span><span class="lt"><b>{{ l.title }}</b><span>{{ l.summary }}</span></span><span class="pill">{{ t.course.later }}</span></div></li>
    {% endif %}
    {% endfor %}
  </ol>
  <div class="backup">
    <span>{{ t.course.saved }}</span>
    <button class="btn" type="button" data-export>{{ t.course.export }}</button>
    <label class="btn" for="imp">{{ t.course.import }}</label><input id="imp" type="file" accept="application/json" data-import>
    <span data-backup-msg role="status"></span>
  </div>
</div>
